// Ziti Desktop Edge (ziti-edge-tunnel-gui)
// Let active, local members of the "ziti" group connect/disconnect/restart the
// existing ziti-edge-tunnel.service without a password - the same as the
// Windows and Android clients, where any desktop user can toggle the tunnel.
// Only these three verbs on this one unit are granted; enabling/disabling the
// service at boot and editing its configuration still require an administrator.
// Requires polkit >= 0.106 (JavaScript rules). Delete this file to always prompt.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "ziti-edge-tunnel.service" &&
        ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0 &&
        subject.isInGroup("ziti") && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
